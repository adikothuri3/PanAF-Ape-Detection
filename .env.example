# Copy to `.env` and edit. `.env` is git-ignored and must never be committed.
#
# These are *operational* overrides only -- the knobs that legitimately differ
# between a laptop, a Colab GPU runtime and CI. Anything scientifically
# meaningful (thresholds you are studying, clip selection, tracker settings)
# belongs in a versioned YAML file under configs/ so that it shows up in a diff.
#
# Nothing in this project requires a credential today. If that ever changes,
# secrets go here -- never in configs/*.yaml, never in a notebook cell.

# Compute device: auto | cpu | cuda | mps
# PANAF_DEVICE=auto

# Exact MegaDetector V6 weight variant. See docs/model.md for the accepted set.
# PANAF_MODEL_VARIANT=MDV6-yolov9-c

# Detection score threshold, in [0, 1].
# PANAF_CONFIDENCE_THRESHOLD=0.2

# Where generated outputs are written. Git-ignored.
# PANAF_ARTIFACTS_DIR=artifacts

# Upper bound on clips processed in one run.
# PANAF_MAX_CLIPS=8

# DEBUG | INFO | WARNING | ERROR | CRITICAL
# PANAF_LOG_LEVEL=INFO

# Experiment slug used to name outputs.
# PANAF_EXPERIMENT_NAME=phase1-baseline

# Override repository-root discovery. Rarely needed; useful in Colab when the
# package is installed outside a checkout.
# PANAF_REPO_ROOT=/content/panaf-ape-detection
