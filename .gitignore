junit*.xml

# --------------------------------------------------------------------------- #
# Local environment and secrets
# --------------------------------------------------------------------------- #
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml
service-account*.json

# --------------------------------------------------------------------------- #
# Model weights and checkpoints -- never committed. Weights are redistributed
# under their own licence; see docs/obsidian/05 Technical/licensing.md.
# --------------------------------------------------------------------------- #
*.pt
*.pth
*.onnx
*.tflite
*.pb
*.h5
*.hdf5
*.ckpt
*.safetensors
*.bin
# Partial downloads. PyTorch-Wildlife writes `MDV6-yolov9-c.pt<random>.tmp` while
# fetching weights, and an interrupted run leaves a 46 MB file in the repo root
# that none of the patterns above match -- `.tmp` is the suffix, not `.pt`.
*.tmp
# Root-anchored so they cannot shadow a future source package of the same name.
/weights/
/checkpoints/
/models/

# --------------------------------------------------------------------------- #
# Dataset files -- video, imagery and extracted frames. Never committed.
# See data/README.md.
# --------------------------------------------------------------------------- #
data/**
!data/README.md
!data/sample_manifest.example.csv
!data/raw/
!data/interim/
!data/processed/
!data/**/.gitkeep

# Your actual clip selection reveals dataset contents; only the template is tracked.
data/sample_manifest.csv

# Media formats, wherever they end up
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.flv
*.wmv
*.m4v
*.mpg
*.mpeg
*.gif
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.bmp
*.webp
*.npy
*.npz
# Documentation figures are tracked deliberately, once they exist.
!docs/obsidian/05 Technical/**/*.png
!docs/obsidian/05 Technical/**/*.svg

# Write-up figures. reports/phase1_writeup_template.md asks for a compact figure
# in reports/figures/ and references it as figures/<name>.png -- without these
# negations the blanket image rules above would swallow it with no error, and the
# deliverable would be missing a figure nobody noticed was dropped.
!reports/figures/**
!reports/figures/*.png
!reports/figures/*.jpg
!reports/figures/*.jpeg
!reports/figures/*.gif
!reports/figures/*.svg

# --------------------------------------------------------------------------- #
# Generated artifacts -- everything, always. Regenerate, never commit.
# --------------------------------------------------------------------------- #
artifacts/
outputs/
output/
results/
runs/
logs/
*.log

