*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --------------------------------------------------------------------------- #
# Virtual environments
# --------------------------------------------------------------------------- #
.venv/
venv/
env/
ENV/
.conda/
.uv/

# --------------------------------------------------------------------------- #
# Testing, coverage and type-checker caches
# --------------------------------------------------------------------------- #
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
